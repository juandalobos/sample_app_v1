<% if current_user.following?(@user) %>
  <%= form_with(
        model: current_user.active_relationships.find_by(followed_id: @user.id),
        url: relationship_path(current_user.active_relationships.find_by(followed_id: @user.id)),
        method: :delete,
        local: true
      ) do |f| %>
    <%= f.submit "Unfollow", class: "btn btn-secondary" %>
  <% end %>
<% else %>
  <%= form_with(
        model: current_user.active_relationships.build(followed_id: @user.id),
        local: true
      ) do |f| %>
    <%= f.hidden_field :followed_id %>
    <%= f.submit "Follow", class: "btn btn-primary" %>
  <% end %>
<% end %>